# --- Database ---
# Local dev: leave as-is, a SQLite file will be created under ./data/
# Production (Vercel etc.): point at a Turso database (libsql://... ) so
# data survives across serverless invocations. Vercel's filesystem is not persistent.
DATABASE_URL=file:./data/local.db
DATABASE_AUTH_TOKEN=

# --- Web push (browser/device notifications) ---
# Generate with: npm run generate-vapid
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Email reminders (via Resend) ---
# Sign up free at https://resend.com, create an API key.
# Until you verify a sending domain, Resend only lets you send to the
# email address on your own account.
RESEND_API_KEY=
RESEND_FROM=Homework Tracker <onboarding@resend.dev>
REMINDER_EMAIL_TO=you@example.com

# --- Cron endpoint protection ---
# Any long random string. Required in production so randoms on the internet
# can't trigger your reminder-check endpoint.
CRON_SECRET=

# --- Google Calendar sync (optional) ---
# See README section 6 for the full Google Cloud setup walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your deployed URL (no trailing slash) — also builds the OAuth redirect URI.
# Falls back to the request's own host if unset, which is fine for local dev.
APP_URL=
